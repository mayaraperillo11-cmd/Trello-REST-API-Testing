    {
      "name": "Create Board",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "let jsonData = pm.response.json();\r",
              "\r",
              "pm.environment.set(\"boardID\", jsonData.id);\r",
              "\r",
              "pm.test('Check if id exists', function () {\r",
              "    pm.expect(jsonData.id).to.exist;\r",
              "});\r",
              "\r",
              "pm.test('Check if name exists', function () {\r",
              "    pm.expect(jsonData.name).to.exist;\r",
              "});\r",
              "\r",
              "pm.test('Check if url exists', function () {\r",
              "    pm.expect(jsonData.url).to.exist;\r",
              "});\r",
              "\r",
              "let createboardname = pm.environment.get (\"myboardname\");\r",
              "pm.test(\"Correct Board Name\", function () {\r",
              "    pm.expect(jsonData.name).to.eql(createboardname);\r",
              "});\r",
              "\r",
              "pm.test(\"Status code is 200\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "// Generate a random 3-digit number\r",
              "let randomNum = Math.floor(Math.random() * 1000)\r",
              "    .toString()\r",
              "    .padStart(3, '0');\r",
              "\r",
              "// Create the dynamic value\r",
              "let uniqueValue = `myboard${randomNum}`;\r",
              "\r",
              "// Set it as an environment variable\r",
              "pm.environment.set(\"myboardname\", uniqueValue);"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
